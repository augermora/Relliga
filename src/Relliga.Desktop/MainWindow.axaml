<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Relliga.Desktop" xmlns:d="using:Relliga.Domain"
        x:Class="Relliga.Desktop.MainWindow" x:DataType="local:MainViewModel"
        Title="Relliga — Your digital life, together." Icon="/Assets/Relliga.ico" Width="1240" Height="820" MinWidth="900" MinHeight="650"
        Background="#101622" WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Alt+D1" Command="{Binding NavigateCommand}" CommandParameter="0" />
    <KeyBinding Gesture="Alt+D2" Command="{Binding NavigateCommand}" CommandParameter="1" />
    <KeyBinding Gesture="Alt+D3" Command="{Binding NavigateCommand}" CommandParameter="2" />
    <KeyBinding Gesture="Alt+D4" Command="{Binding NavigateCommand}" CommandParameter="3" />
    <KeyBinding Gesture="Alt+D5" Command="{Binding NavigateCommand}" CommandParameter="4" />
    <KeyBinding Gesture="Alt+D6" Command="{Binding NavigateCommand}" CommandParameter="5" />
    <KeyBinding Gesture="Alt+D7" Command="{Binding NavigateCommand}" CommandParameter="6" />
    <KeyBinding Gesture="Alt+D8" Command="{Binding NavigateCommand}" CommandParameter="7" />
    <KeyBinding Gesture="Alt+D9" Command="{Binding NavigateCommand}" CommandParameter="8" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding NavigateCommand}" CommandParameter="3" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ShowImportCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding NavigateCommand}" CommandParameter="5" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </Window.KeyBindings>
  <Grid ColumnDefinitions="210,*">
    <Border Background="#0C111C" BorderBrush="#263045" BorderThickness="0,0,1,0" Padding="20,32,16,20">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="9" Margin="8,0,0,36">
          <Border Background="#A9C7FF" CornerRadius="12" Width="40" Height="40" HorizontalAlignment="Left">
            <TextBlock Text="r" Foreground="#101B2E" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
          </Border>
          <TextBlock Text="Relliga" FontSize="25" FontWeight="SemiBold" />
          <TextBlock Text="Your digital life,&#10;together." Classes="muted" FontSize="12" LineHeight="19" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="YOUR LIBRARY" Classes="eyebrow" Margin="12,0,0,12" />
        <ListBox Grid.Row="2" ItemsSource="{Binding Sections}" SelectedIndex="{Binding SelectedSection}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Main navigation" AutomationProperties.HelpText="Use arrow keys to choose a section, or Alt plus 1 through 9." KeyboardNavigation.TabNavigation="Once" />
        <StackPanel Grid.Row="3" Margin="8,16,0,0" Spacing="7">
          <TextBlock Text="●  Local &amp; private" Foreground="#9ADBC4" FontSize="12" />
          <TextBlock Text="Offline library. Optional connections." Classes="muted" FontSize="11" TextWrapping="Wrap" />
          <TextBlock Text="{Binding VersionLabel}" Classes="muted" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="32,28,32,18">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
        <StackPanel Spacing="7"><TextBlock Text="PERSONAL DIGITAL ARCHIVE" Classes="eyebrow" /><TextBlock Text="{Binding PageTitle}" Classes="heading" /></StackPanel>
        <Button Grid.Column="1" Content="Import personal data" Classes="primary" Command="{Binding ShowImportCommand}" VerticalAlignment="Center" />
      </Grid>
      <Border Grid.Row="1" Background="#38272E" BorderBrush="#B67787" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16" IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="*,Auto"><ScrollViewer MaxHeight="130" HorizontalScrollBarVisibility="Disabled"><SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#FFDAE0" AutomationProperties.Name="Library error" AutomationProperties.LiveSetting="Assertive" /></ScrollViewer><Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissErrorCommand}" Margin="16,0,0,0" VerticalAlignment="Top" /></Grid>
      </Border>
      <Grid Grid.Row="2">
        <ScrollViewer IsVisible="{Binding IsConnections}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="20">
            <Border Classes="card"><StackPanel Spacing="16">
              <TextBlock Text="Your accounts, connected." FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="Relliga uses the official Telegram API through TDLib. Connect only an account you control. Synchronization runs while this application is open; your library remains available offline." TextWrapping="Wrap" Classes="muted" LineHeight="24" />
              <TextBlock Text="Telegram" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ConnectionState}" FontSize="18" Foreground="#A9C7FF" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding ConnectionDescription}" TextWrapping="Wrap" LineHeight="24" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding LastSynchronization}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ConnectedAccountLabel}" Classes="muted" TextWrapping="Wrap" />
              <WrapPanel><Button Content="Connect / resume" Command="{Binding ConnectAccountCommand}" Classes="primary" Margin="0,0,12,12" /><Button Content="Refresh now" Command="{Binding RefreshAccountCommand}" Margin="0,0,12,12" /><Button Content="Pause automatic sync" Command="{Binding PauseAccountCommand}" Margin="0,0,12,12" /><Button Content="Disconnect…" Command="{Binding DisconnectAccountCommand}" Margin="0,0,0,12" /></WrapPanel>
              <StackPanel IsVisible="{Binding NeedsAuthorization}" Spacing="12">
                <TextBlock Text="{Binding AuthorizationKind}" FontWeight="SemiBold" />
                <TextBox Text="{Binding AuthorizationInput}" PasswordChar="●" AutomationProperties.Name="Telegram authorization input" MaxLength="1024" PlaceholderText="Enter the requested value" />
                <Button Content="Submit authorization" Command="{Binding SubmitAuthorizationCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12">
              <TextBlock Text="Private by choice" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Windows protects persistent session keys with DPAPI for your user. Passwords and verification codes are not saved. Sessions are excluded from library backups. Disconnect keeps local history; local deletion is separate. Opening a connected conversation sends normal read receipts." TextWrapping="Wrap" Classes="muted" LineHeight="24" />
              <TextBlock Text="Live support covers private cloud chats and groups. Secret chats, channels, disappearing and protected content are excluded. Channels require sponsored-message support before they can be enabled. Attachments are represented by metadata and are never downloaded. The publisher must configure official TDLib and Relliga-owned application credentials; ordinary users should not obtain developer credentials." TextWrapping="Wrap" Classes="muted" LineHeight="24" />
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        <Grid IsVisible="{Binding IsConversations}" ColumnDefinitions="250,16,*" RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.ColumnSpan="3" Spacing="10" Margin="0,0,0,16">
            <TextBlock Text="Your conversations, on this device." FontSize="20" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding ConversationFilter}" PlaceholderText="Filter conversation titles…" AutomationProperties.Name="Conversation title filter" /><Button Grid.Column="1" Content="Find conversations" Command="{Binding FindConversationsCommand}" Margin="12,0,0,0" /></Grid>
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" Background="#141D2B" BorderBrush="#263045" BorderThickness="1" Padding="8" AutomationProperties.Name="Telegram conversations">
            <ListBox.ItemTemplate><DataTemplate x:DataType="d:ConversationSummary"><StackPanel Spacing="5" Margin="4,8"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock Text="{Binding Messages, StringFormat='{}{0:N0} messages'}" Classes="muted" FontSize="12" /><TextBlock Text="{Binding Type}" Classes="muted" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,*,160">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"><TextBox Text="{Binding ConversationSearch}" PlaceholderText="Search messages in this conversation…" AutomationProperties.Name="Conversation message search" /><Button Grid.Column="1" Content="Search" Command="{Binding SearchConversationCommand}" Margin="12,0,0,0" /></Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" Background="#141D2B" BorderBrush="#263045" BorderThickness="1" Padding="8" AutomationProperties.Name="Conversation messages">
              <ListBox.ItemTemplate><DataTemplate x:DataType="local:EventItem"><StackPanel Margin="6,10" Spacing="6"><TextBlock Text="{Binding Artist}" FontWeight="SemiBold" Foreground="#A9C7FF" /><TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DateLabel}" Classes="muted" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Row="2" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled"><SelectableTextBlock Text="{Binding ConversationDetails}" TextWrapping="Wrap" FontSize="12" /></ScrollViewer>
          </Grid>
          <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0"><TextBlock Text="{Binding ConversationPageLabel}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Newer" Command="{Binding NewerMessagesCommand}" Margin="12,0" /><Button Grid.Column="2" Content="Older" Command="{Binding OlderMessagesCommand}" /></Grid>
        </Grid>
        <ScrollViewer IsVisible="{Binding IsDashboard}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="22">
            <Border Classes="card" Background="#1A2940" Padding="30">
              <StackPanel Spacing="14">
                <TextBlock Text="A little more yours." FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="Bring your digital history home. Music, plans, and everyday moments,&#10;preserved together in a timeline that belongs to you." TextWrapping="Wrap" Classes="muted" LineHeight="24" />
                <Button Content="Connect an account →" Command="{Binding ShowConnectionsCommand}" HorizontalAlignment="Left" Classes="primary" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,16,*,16,1.3*">
              <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="PRESERVED RECORDS" Classes="eyebrow" /><TextBlock Text="{Binding EventCount}" FontSize="36" FontWeight="SemiBold" /><TextBlock Text="Plays, messages + Calendar series" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel></Border>
              <Border Grid.Column="2" Classes="card"><StackPanel Spacing="12"><TextBlock Text="SOURCES" Classes="eyebrow" /><TextBlock Text="{Binding SourceCount}" FontSize="36" FontWeight="SemiBold" /><TextBlock Text="Imports + authorized connections" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel></Border>
              <Border Grid.Column="4" Classes="card"><StackPanel Spacing="16"><TextBlock Text="LATEST IMPORT" Classes="eyebrow" /><TextBlock Text="{Binding LatestImport}" FontSize="16" TextWrapping="Wrap" LineHeight="26" /></StackPanel></Border>
            </Grid>
            <Border Classes="card"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="12"><TextBlock Text="Your sources" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding SourceStatistics}" Classes="muted" TextWrapping="Wrap" LineHeight="24" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding SuccessfulImportCount}" FontWeight="SemiBold" /><TextBlock Text="successful imports" Classes="muted" /></StackPanel><TextBlock Text="Recurring occurrences are calculated in the selected timeline window." Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="Explore timeline →" Command="{Binding ShowTimelineCommand}" VerticalAlignment="Center" Margin="16,0,0,0" /></Grid></Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding IsImport}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="20">
            <TextBlock Text="Your history has a home here." FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Add Spotify history, Telegram Desktop JSON or Google Calendar ICS exports. Files are read locally; nothing is uploaded." Classes="muted" TextWrapping="Wrap" LineHeight="23" />
            <Border Classes="card" Padding="28">
              <StackPanel Spacing="18">
                <TextBlock Text="01  CHOOSE AN EXPORT" Classes="eyebrow" />
                <TextBlock Text="Music, calendars, and the moments between" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="JSON, ICS or ZIP · Automatic source detection · Safe to reimport" Classes="muted" TextWrapping="Wrap" />
                <Button Content="Choose file…" Command="{Binding PickFileCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding SelectedFile}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Preview}" Classes="muted" TextWrapping="Wrap" LineHeight="24" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button Content="Import into library" Classes="primary" Command="{Binding ImportCommand}" />
                  <Button Content="Cancel operation" Command="{Binding CancelCommand}" IsVisible="{Binding IsCancellable}" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
              </StackPanel>
            </Border>
            <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="02  IMPORT RESULT" Classes="eyebrow" /><TextBlock Text="{Binding ImportResult}" TextWrapping="Wrap" LineHeight="24" /><Button Content="View timeline →" Command="{Binding ShowTimelineCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
            <StackPanel Spacing="10"><TextBlock Text="Recent operations" FontSize="18" FontWeight="SemiBold" />
              <ListBox ItemsSource="{Binding RecentImports}" SelectedItem="{Binding SelectedImport}" MaxHeight="180" AutomationProperties.Name="Import history">
                <ListBox.ItemTemplate><DataTemplate x:DataType="local:ImportItem"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" /></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="{Binding SelectedImport.Message}" TextWrapping="Wrap" Classes="muted" LineHeight="22" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Grid IsVisible="{Binding IsExplorer}" RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Spacing="12" Margin="0,0,0,16">
            <TextBlock Text="Messages, music and plans, together." Classes="muted" IsVisible="{Binding IsTimeline}" />
            <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="Search music, calendar titles, descriptions, locations…" IsVisible="{Binding IsSearch}" AutomationProperties.Name="Search text" AutomationProperties.HelpText="Word prefixes are combined with AND. Press Enter to apply." MaxLength="500">
              <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding FilterCommand}" /></TextBox.KeyBindings>
            </TextBox>
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Spacing="6"><TextBlock Text="Source" Classes="muted" FontSize="12" /><ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SourceFilter}" HorizontalAlignment="Stretch" AutomationProperties.Name="Source filter" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Event type" Classes="muted" FontSize="12" /><ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding KindFilter}" HorizontalAlignment="Stretch" AutomationProperties.Name="Event type filter" /></StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,12,*,12,Auto,8,Auto">
              <StackPanel Spacing="6"><TextBlock Text="From date" Classes="muted" FontSize="12" /><TextBox Text="{Binding FromDate}" PlaceholderText="YYYY-MM-DD" AutomationProperties.Name="From date" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Through date" Classes="muted" FontSize="12" /><TextBox Text="{Binding ToDate}" PlaceholderText="YYYY-MM-DD" AutomationProperties.Name="Through date" /></StackPanel>
              <Button Grid.Column="4" Content="Apply" Command="{Binding FilterCommand}" Classes="primary" VerticalAlignment="Bottom" />
              <Button Grid.Column="6" Content="Clear" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" />
            </Grid>
            <TextBlock Text="{Binding RangeNote}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsQuerying}" Height="3" Margin="0,0,0,8" />
          <Grid Grid.Row="2" ColumnDefinitions="1.4*,16,*">
            <Grid>
              <ListBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" Background="#141D2B" BorderThickness="0" IsVisible="{Binding HasEvents}" AutomationProperties.Name="Unified timeline events">
                <ListBox.ItemTemplate><DataTemplate x:DataType="local:EventItem">
                  <StackPanel Spacing="7" Margin="0,4"><TextBlock Text="{Binding SourceLabel}" Foreground="{Binding AccentBrush}" FontSize="11" /><TextBlock Text="{Binding DateLabel}" Foreground="#A7C5FF" FontSize="11" /><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Artist}" Classes="muted" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding PlaybackLabel}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Border Classes="card" IsVisible="{Binding HasNoEvents}" VerticalAlignment="Top"><StackPanel Spacing="14"><TextBlock Text="Room for your story" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding EmptyMessage}" Classes="muted" TextWrapping="Wrap" LineHeight="23" /><Button Content="Import personal data" Command="{Binding ShowImportCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
            </Grid>
            <Border Grid.Column="2" Classes="card" Padding="20">
              <Grid RowDefinitions="Auto,*"><TextBlock Text="EVENT DETAILS" Classes="eyebrow" Margin="0,0,0,18" />
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><SelectableTextBlock Text="{Binding SelectedDetails}" TextWrapping="Wrap" FontSize="12" LineHeight="22" /></ScrollViewer>
              </Grid>
            </Border>
          </Grid>
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto,8,Auto" Margin="0,16,0,0"><TextBlock Text="{Binding PageLabel}" Classes="muted" VerticalAlignment="Center" /><Button Grid.Column="1" Content="← Previous" Command="{Binding PreviousCommand}" /><Button Grid.Column="3" Content="Next →" Command="{Binding NextCommand}" /></Grid>
        </Grid>

        <Grid IsVisible="{Binding IsHistory}" RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="12" Margin="0,0,0,20"><TextBlock Text="Every import, with a clear account of what was preserved." Classes="muted" TextWrapping="Wrap" /><Button Content="Review removal of selected batch…" Command="{Binding RemoveImportCommand}" HorizontalAlignment="Left" /></StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*,16,*">
            <ListBox ItemsSource="{Binding RecentImports}" SelectedItem="{Binding SelectedImport}" Background="#141D2B" AutomationProperties.Name="All import operations">
              <ListBox.ItemTemplate><DataTemplate x:DataType="local:ImportItem"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" LineHeight="23" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Classes="card"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><SelectableTextBlock Text="{Binding SelectedImport.Details}" TextWrapping="Wrap" LineHeight="24" FontSize="12" /></ScrollViewer></Border>
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,8,Auto" Margin="0,16,0,0"><TextBlock Text="{Binding HistoryPageLabel}" Classes="muted" VerticalAlignment="Center" /><Button Grid.Column="1" Content="← Previous" Command="{Binding PreviousHistoryCommand}" /><Button Grid.Column="3" Content="Next →" Command="{Binding NextHistoryCommand}" /></Grid>
        </Grid>

        <ScrollViewer IsVisible="{Binding IsLibrary}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="20">
            <Border Classes="card"><StackPanel Spacing="14">
              <TextBlock Text="Take your history with you." FontSize="24" FontWeight="SemiBold" />
              <TextBlock Text="Export every matching record, including results beyond the current page. JSON preserves missing values, source metadata, Calendar definitions and all import origins. CSV is suitable for spreadsheets and protects formula-like text." Classes="muted" TextWrapping="Wrap" LineHeight="24" />
              <TextBlock Text="FORMAT" Classes="eyebrow" /><ComboBox ItemsSource="{Binding ExportFormats}" SelectedIndex="{Binding ExportFormat}" IsEnabled="{Binding CanWork}" HorizontalAlignment="Stretch" AutomationProperties.Name="Export format" />
              <TextBlock Text="SCOPE" Classes="eyebrow" /><ComboBox ItemsSource="{Binding ExportScopes}" SelectedIndex="{Binding ExportScope}" IsEnabled="{Binding CanWork}" HorizontalAlignment="Stretch" AutomationProperties.Name="Export scope" />
              <TextBlock Text="{Binding ExportScopeSummary}" Classes="muted" TextWrapping="Wrap" LineHeight="23" />
              <Grid ColumnDefinitions="*,12,*" IsEnabled="{Binding ExportUsesDates}"><TextBox Text="{Binding FromDate}" PlaceholderText="From YYYY-MM-DD" AutomationProperties.Name="Export from date" /><TextBox Grid.Column="2" Text="{Binding ToDate}" PlaceholderText="Through YYYY-MM-DD" AutomationProperties.Name="Export through date" /></Grid>
              <Button Content="Choose destination &amp; export…" Classes="primary" Command="{Binding ExportDataCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="Calendar exports contain occurrences in a bounded window. Use a library backup to preserve complete recurring definitions and history for restoration." Classes="muted" TextWrapping="Wrap" FontSize="12" />
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="14">
              <TextBlock Text="Manage imported sources" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SourceStatistics}" Classes="muted" TextWrapping="Wrap" LineHeight="24" />
              <ComboBox ItemsSource="{Binding AvailableSources}" SelectedItem="{Binding SelectedRemovalSource}" IsEnabled="{Binding CanWork}" HorizontalAlignment="Stretch" PlaceholderText="Select an imported source" AutomationProperties.Name="Source to remove" />
              <Button Content="Review source removal…" Command="{Binding RemoveSourceCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="Review exact stored-record counts before confirming. Remove a specific batch in Import history. Shared records survive; Calendar revisions are recalculated. External originals are untouched. Deletion is logical and does not erase external backups or the previous restore recovery copy." Classes="muted" TextWrapping="Wrap" LineHeight="23" />
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="Latest library operation" Classes="eyebrow" /><TextBlock Text="{Binding OwnershipResult}" TextWrapping="Wrap" LineHeight="24" /></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding IsAbout}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="20">
            <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Relliga" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="Your digital life, together." FontSize="18" Classes="muted" /><TextBlock Text="{Binding AboutVersion}" /><TextBlock Text="Preserve, explore, export and manage your personal digital history. Spotify and Google Calendar stay together in a searchable local library." Classes="muted" TextWrapping="Wrap" LineHeight="24" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="14">
              <TextBlock Text="Backup &amp; restore" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Create a verified portable ZIP with a consistent SQLite snapshot and SHA-256 checksum. Backups contain sensitive, unencrypted personal information. Store them securely. Original export files are not included." Classes="muted" TextWrapping="Wrap" LineHeight="24" />
              <WrapPanel><Button Content="Create backup…" Command="{Binding CreateBackupCommand}" Margin="0,0,12,12" /><Button Content="Preview &amp; restore backup…" Command="{Binding RestoreBackupCommand}" Margin="0,0,0,12" /></WrapPanel>
              <TextBlock Text="Restore replaces the entire active library after validation and confirmation. The previous library is retained as relliga.db.previous until discarded or replaced by the next restore. It can still contain deleted information." Classes="muted" TextWrapping="Wrap" LineHeight="24" />
              <Button Content="Review discarding recovery copy…" Command="{Binding DiscardRecoveryCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding OwnershipResult}" TextWrapping="Wrap" LineHeight="23" />
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="Library health" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding HealthStatus}" Classes="muted" TextWrapping="Wrap" LineHeight="24" /><Button Content="Verify library" Command="{Binding VerifyLibraryCommand}" HorizontalAlignment="Left" /><ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsBusy}" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="Privacy by design" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Your library stays on this device. Relliga has no telemetry or cloud storage. An explicitly connected Telegram account communicates with Telegram through official TDLib while the app runs. Manual imports and offline browsing need no connection." TextWrapping="Wrap" LineHeight="24" /><TextBlock Text="The library is not encrypted at rest. Export metadata can include your Spotify username and IP address. Protect your device and backups accordingly." Classes="muted" TextWrapping="Wrap" LineHeight="24" /><TextBlock Text="LOCAL LIBRARY" Classes="eyebrow" /><SelectableTextBlock Text="{Binding DatabaseLocation}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="Free software. Yours to improve." FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Licensed under the GNU General Public License, version 3. You may use, study, share, and modify Relliga under its terms. Provided without warranty. See LICENSE in the source repository." Classes="muted" TextWrapping="Wrap" LineHeight="24" /></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid Grid.Row="3" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" Margin="0,18,0,0">
        <ProgressBar Grid.ColumnSpan="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" Margin="0,0,0,8" AutomationProperties.Name="Library operation in progress" />
        <TextBlock Grid.Row="1" Text="{Binding Status}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" AutomationProperties.Name="Library status" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" />
        <Button Grid.Row="1" Grid.Column="1" Content="Cancel operation" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" Margin="12,0,0,0" />
        <Button Grid.Row="1" Grid.Column="2" Content="Retry opening library" Command="{Binding InitializeCommand}" IsVisible="{Binding NeedsInitialization}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
