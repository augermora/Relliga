root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,axaml,csproj,props,slnx}]
indent_size = 2

[tests/**/*.cs]
# Tests that intentionally exercise cancellation use their own token; other small fixture operations are bounded.
dotnet_diagnostic.xUnit1051.severity = none
